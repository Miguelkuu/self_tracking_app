// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

// Get a free hosted Postgres database in seconds: `npx create-db`

generator client {
  provider = "prisma-client"
  output   = "../lib/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

enum AccountType {
  CHECKING
  SAVINGS
  CREDIT_CARD
  LOAN
  OTHER
}

model Account {
  id              String        @id @default(cuid())
  name            String
  type            AccountType   @default(OTHER)
  // Credit card / loan details, used by the payoff planner. APR is a percentage
  // (26.74 = 26.74%); minPayment is a card's fixed minimum floor (e.g. $35).
  apr             Decimal?      @db.Decimal(5, 2)
  creditLimit     Decimal?      @db.Decimal(12, 2)
  minPayment      Decimal?      @db.Decimal(12, 2)
  // Installment loans (Affirm, Klarna, car loan): what was owed right before
  // `nextPaymentDate`, paid down by `monthlyPayment` on that day each month.
  // The current balance is worked out from these, so it counts down on its own.
  loanAmount      Decimal?      @db.Decimal(12, 2)
  monthlyPayment  Decimal?      @db.Decimal(12, 2)
  nextPaymentDate DateTime?
  startingBalance Decimal       @default(0) @db.Decimal(12, 2)
  archived        Boolean       @default(false)
  createdAt       DateTime      @default(now())
  // The bank's name for this account in CSV exports (e.g. "Bank of America -
  // Bank - Safe Balance Banking"), remembered so imports can auto-map it.
  importName      String?       @unique
  transactions    Transaction[]
  bills           Bill[]
}

enum CategoryKind {
  INCOME
  EXPENSE
}

model Category {
  id           String        @id @default(cuid())
  name         String
  kind         CategoryKind
  color        String        @default("#64748b")
  archived     Boolean       @default(false)
  transactions Transaction[]

  @@unique([name, kind])
}

enum TransactionKind {
  INCOME
  EXPENSE
}

model Transaction {
  id          String          @id @default(cuid())
  kind        TransactionKind
  amount      Decimal         @db.Decimal(12, 2)
  date        DateTime
  description String
  notes       String?
  accountId   String
  account     Account         @relation(fields: [accountId], references: [id], onDelete: Cascade)
  categoryId  String?
  category    Category?       @relation(fields: [categoryId], references: [id], onDelete: SetNull)
  // Fingerprint of the CSV row this came from; null for manual entries.
  // Unique so re-importing an overlapping export can't create duplicates.
  importId    String?         @unique
  // Money moved between your own accounts: changes balances but is not
  // income or spending. `kind` still says which direction it went.
  isTransfer  Boolean         @default(false)
  createdAt   DateTime        @default(now())

  @@index([date])
}

enum BillRecurrence {
  MONTHLY
  WEEKLY
  YEARLY
  ONE_TIME
}

model Bill {
  id            String         @id @default(cuid())
  name          String
  category      String?
  recurrence    BillRecurrence @default(MONTHLY)
  amount        Decimal?       @db.Decimal(12, 2)
  dueDayOfMonth Int?
  dueDate       DateTime?
  autopay       Boolean        @default(false)
  accountId     String?
  account       Account?       @relation(fields: [accountId], references: [id], onDelete: SetNull)
  notes         String?
  archived      Boolean        @default(false)
  createdAt     DateTime       @default(now())
  payments      BillPayment[]
}

model BillPayment {
  id          String    @id @default(cuid())
  billId      String
  bill        Bill      @relation(fields: [billId], references: [id], onDelete: Cascade)
  periodLabel String
  dueDate     DateTime
  amount      Decimal   @db.Decimal(12, 2)
  paid        Boolean   @default(false)
  paidDate    DateTime?
  createdAt   DateTime  @default(now())

  @@unique([billId, periodLabel])
  @@index([dueDate])
  @@index([paid])
}

model Subject {
  id          String       @id @default(cuid())
  name        String       @unique
  color       String       @default("#3b82f6")
  archived    Boolean      @default(false)
  assignments Assignment[]
}

enum AssignmentType {
  HOMEWORK
  TEST
  PROJECT
  OTHER
}

enum Priority {
  LOW
  MEDIUM
  HIGH
}

model Assignment {
  id         String         @id @default(cuid())
  subjectId  String
  subject    Subject        @relation(fields: [subjectId], references: [id], onDelete: Cascade)
  title      String
  type       AssignmentType @default(HOMEWORK)
  dueDate    DateTime
  done       Boolean        @default(false)
  doneAt     DateTime?
  priority   Priority       @default(MEDIUM)
  notes      String?
  // UID from the school calendar feed; null for assignments added by hand.
  externalId String?        @unique
  createdAt  DateTime       @default(now())

  @@index([dueDate])
  @@index([done])
}

model ExerciseCategory {
  id        String     @id @default(cuid())
  name      String     @unique
  color     String     @default("#f97316")
  exercises Exercise[]
}

model Exercise {
  id         String            @id @default(cuid())
  name       String            @unique
  categoryId String?
  category   ExerciseCategory? @relation(fields: [categoryId], references: [id], onDelete: SetNull)
  archived   Boolean           @default(false)
  sets       WorkoutSet[]
}

model WorkoutSession {
  id        String       @id @default(cuid())
  date      DateTime     @default(now())
  name      String?
  notes     String?
  createdAt DateTime     @default(now())
  sets      WorkoutSet[]

  @@index([date])
}

enum WeightUnit {
  KG
  LB
}

model WorkoutSet {
  id               String         @id @default(cuid())
  workoutSessionId String
  workoutSession   WorkoutSession @relation(fields: [workoutSessionId], references: [id], onDelete: Cascade)
  exerciseId       String
  exercise         Exercise       @relation(fields: [exerciseId], references: [id], onDelete: Restrict)
  setNumber        Int
  reps             Int
  weight           Decimal        @db.Decimal(6, 2)
  weightUnit       WeightUnit     @default(KG)
  notes            String?
  createdAt        DateTime       @default(now())

  @@index([exerciseId])
  @@index([workoutSessionId])
}

// Class meetings and other timed events from the school calendar feed.
// Fully replaced on every sync, so nothing here is edited by hand.
model ClassEvent {
  id       String   @id @default(cuid())
  uid      String   @unique // feed UID + start time (recurring events repeat UIDs)
  title    String
  subject  String?
  location String?
  start    DateTime
  end      DateTime
  allDay   Boolean  @default(false)

  @@index([start])
}

// Small app-wide settings (e.g. the school calendar feed URL).
model Setting {
  key   String @id
  value String
}
