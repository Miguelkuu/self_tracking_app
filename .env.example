# Copy this file to .env and fill in real values. Never commit .env itself.

# Postgres credentials (used both by docker-compose to init the db container,
# and inside DATABASE_URL below to connect to it)
POSTGRES_USER=selftracker
POSTGRES_PASSWORD=changeme
POSTGRES_DB=selftracker

# Local dev (app runs on the host, Postgres container's port is published to
# localhost). When running via `docker compose up` (app also containerized),
# docker-compose.yml overrides this to point at the "db" service instead.
DATABASE_URL=postgresql://selftracker:changeme@localhost:5432/selftracker

# Session signing secret — generate with: openssl rand -base64 32
AUTH_SECRET=changeme_random_32_bytes

# Login credentials — see scripts/hash-password.ts to generate the hash.
# Careful: bcrypt hashes contain literal `$` characters, which Next.js's env
# loader treats as variable interpolation unless escaped as `\$`.
ADMIN_USERNAME=changeme
ADMIN_PASSWORD_HASH=changeme
